    "/api/v1/search": {
      "get": {
        "summary": "Search the catalog (capped)",
        "description": "Requires at least 2 characters. Returns at most 10 results, with no cursor or total. This is the only catalog discovery endpoint and it cannot be paginated.",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2
            }
          },
          {
            "name": "style",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 10,
              "maximum": 10
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most 10 results"
          },
          "400": {
            "description": "Query too short"
          },
          "429": {
            "description": "Rate limited (30/min/token)"
          }
        },
        "tags": [
          "search"
        ]
      }
    },
    "/api/v1/barcodes/{gtin}": {
      "get": {
        "summary": "Resolve a barcode",
        "description": "Normalizes to GTIN-14, then checks the local catalog, the Open Food Facts cache, and finally Open Food Facts itself. OFF data is returned as an attributed suggestion, never merged into the catalog automatically.",
        "parameters": [
          {
            "name": "gtin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9]{8,14}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "matched | off | unknown"
          },
          "400": {
            "description": "Invalid GTIN check digit"
          },
          "429": {
            "description": "Rate limited"
          }
        },
        "tags": [
          "barcodes"
        ]
      }
    },
    "/api/v1/drinks": {
      "post": {
        "summary": "Create a provisional community drink",
        "description": "Soft-key deduplication means submitting an equivalent soda returns the existing drink with 200 instead of creating a duplicate. Capped at 20/hour/token.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "brand": {
                    "type": "string"
                  },
                  "style_slug": {
                    "type": "string"
                  },
                  "container": {
                    "type": "string",
                    "enum": [
                      "can",
                      "glass",
                      "pet",
                      "fountain",
                      "carton",
                      "other"
                    ]
                  },
                  "volume_ml": {
                    "type": "integer"
                  },
                  "sweetener": {
                    "type": "string"
                  },
                  "carbonation": {
                    "type": "string"
                  },
                  "acid": {
                    "type": "string"
                  },
                  "barcode": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "200": {
            "description": "Existing equivalent returned"
          }
        },
        "tags": [
          "drinks"
        ]
      }
    },
