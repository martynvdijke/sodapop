{
  "openapi": "3.1.0",
  "info": {
    "title": "Sodapop API",
    "version": "1.0.0",
    "summary": "Authenticated, friend-scoped soda check-in API.",
    "description": "Sodapop exposes an intentionally narrow API. There is no endpoint that lists the whole catalog, all users or all venues. Catalog access is limited to single-drink reads, an authenticated search capped at 10 results, and barcode resolution. Social reads are limited to your own data and accepted friends. All data endpoints require a personal `sd_` bearer token; requests are rate limited per token.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "x-sodapop-anti-scraping": {
    "catalog-enumeration": "not exposed",
    "search-min-query": 2,
    "search-max-results": 10,
    "search-rate-limit": "30 requests/minute/token",
    "barcode-rate-limit": "30 requests/minute/token",
    "new-drinks": "20/hour/token",
    "new-venues": "10/hour/token",
    "friend-requests": "20/hour/token"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "sd_<opaque token>",
        "description": "Personal API token created in Settings, or exchanged by the Android app via `/api/v1/auth/mobile-token`. Scopes: read, write, feed."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        }
      },
      "Rating": {
        "type": "object",
        "properties": {
          "avg_rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "rater_count": {
            "type": "integer"
          },
          "rating_shown": {
            "type": "boolean",
            "description": "Averages are shown only after 3 distinct raters."
          }
        }
      },
      "Drink": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "brand": {
            "type": "string"
          },
          "style": {
            "type": "string"
          },
          "container": {
            "type": "string",
            "enum": [
              "can",
              "glass",
              "pet",
              "fountain",
              "carton",
              "other"
            ]
          },
          "volume_ml": {
            "type": "integer"
          },
          "sweetener": {
            "type": "string"
          },
          "carbonation": {
            "type": "string"
          },
          "acid": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "provisional",
              "active",
              "merged"
            ]
          },
          "avg_rating": {
            "type": [
              "number",
              "null"
            ]
          },
          "rater_count": {
            "type": "integer"
          }
        }
      },
      "CheckinInput": {
        "type": "object",
        "required": [
          "drink_id"
        ],
        "properties": {
          "drink_id": {
            "type": "integer"
          },
          "venue_id": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rating": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 5,
            "multipleOf": 0.25
          },
          "serving": {
            "type": "string",
            "enum": [
              "can",
              "bottle",
              "glass",
              "fountain",
              "other"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "friends",
              "private"
            ]
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "description": "Replaying the same key returns the original check-in."
          }
        }
      },
      "Comment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "user": {
            "type": "object",
            "properties": {
              "handle": {
                "type": "string"
              },
              "display_name": {
                "type": "string"
              }
            }
          },
          "body": {
            "type": "string",
            "maxLength": 1000
          },
          "user_id": {
            "type": "string",
            "description": "Author id. Handles are in `user`; ids are stable for deletion checks."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "can_delete": {
            "type": "boolean",
            "description": "True when the viewer authored the comment or is a moderator."
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "body": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "VenueMedia": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "media_id": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "menu"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "uploaded_by": {
            "type": "string"
          },
          "uploader_handle": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "can_remove": {
            "type": "boolean"
          }
        }
      },
      "VenueMediaInput": {
        "type": "object",
        "required": [
          "image"
        ],
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "description": "JPEG, PNG, WebP or GIF; 25 MiB total request body."
          },
          "kind": {
            "type": "string",
            "enum": [
              "photo",
              "menu"
            ],
            "default": "photo"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing or invalid sd_ token",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Rate limit exceeded",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "system",
      "description": "Interactive documentation and service metadata."
    },
    {
      "name": "auth",
      "description": "Token exchange for the web and Android clients."
    },
    {
      "name": "me",
      "description": "Your own profile, stats and notifications."
    },
    {
      "name": "feed",
      "description": "Your viewer-scoped friends-and-follows feed."
    },
    {
      "name": "friends",
      "description": "Friend requests and the accepted friend graph."
    },
    {
      "name": "notifications",
      "description": "Your notification inbox."
    },
    {
      "name": "checkins",
      "description": "Your check-ins and toasts."
    },
    {
      "name": "users",
      "description": "Profiles visible to you."
    },
    {
      "name": "drinks",
      "description": "Single-drink reads and community submissions."
    },
    {
      "name": "search",
      "description": "Capped catalog search."
    },
    {
      "name": "barcodes",
      "description": "GTIN-14 barcode resolution."
    },
    {
      "name": "venues",
      "description": "Venue reads, submissions and saves."
    },
    {
      "name": "ai",
      "description": "Optional Soda Sommelier helpers."
    },
    {
      "name": "integrations",
      "description": "Personal integration status."
    }
  ],
  "paths": {
    "/api/openapi.json": {
      "get": {
        "summary": "This OpenAPI document",
        "security": [],
        "responses": {
          "200": {
            "description": "OpenAPI 3.1 JSON"
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/docs/": {
      "get": {
        "summary": "Swagger UI",
        "security": [],
        "responses": {
          "200": {
            "description": "Interactive API documentation"
          }
        },
        "tags": [
          "system"
        ]
      }
    },
    "/api/v1/auth/oidc/status": {
      "get": {
        "summary": "Discover whether Authelia OIDC is enabled",
        "security": [],
        "responses": {
          "200": {
            "description": "OIDC status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "enabled": {
                          "type": "boolean"
                        },
                        "issuer": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/mobile-token": {
      "post": {
        "summary": "Exchange a browser session for a personal token",
        "description": "Requires the `sd_session` cookie and the per-session CSRF token. Used by the Flutter Android app after Authelia WebView sign-in.",
        "security": [],
        "parameters": [
          {
            "name": "X-CSRF-Token",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Token created (shown once)"
          },
          "403": {
            "description": "CSRF failure or unverified email"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/token": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange email/handle and password for a token",
        "description": "Password sign-in for first-party clients when password login is enabled. Returns a personal `sd_` token shown once. Generic errors avoid account enumeration.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "login",
                  "password"
                ],
                "properties": {
                  "login": {
                    "type": "string",
                    "description": "Email address or handle",
                    "maxLength": 254
                  },
                  "password": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "name": {
                    "type": "string",
                    "description": "Optional token label",
                    "maxLength": 60
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Token created (shown once)"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Password sign-in disabled or email not verified"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "summary": "Current identity and token scopes",
        "responses": {
          "200": {
            "description": "Profile"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/me/checkins": {
      "get": {
        "summary": "List your own check-ins",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 50
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "RFC3339 cursor"
          }
        ],
        "responses": {
          "200": {
            "description": "Check-ins"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/stats/me": {
      "get": {
        "summary": "Your check-in statistics",
        "responses": {
          "200": {
            "description": "Totals"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/stats/me/insights": {
      "get": {
        "summary": "Your sugar, caffeine and calorie insights",
        "description": "Derived from your own non-deleted check-ins and the drink nutrition facts per 100 ml. Self only.",
        "parameters": [
          {
            "name": "range",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "enum": [
                7,
                30,
                90
              ],
              "default": 30
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Insights for the window"
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "tags": [
          "me"
        ]
      }
    },
    "/api/v1/notifications": {
      "get": {
        "summary": "Your notifications",
        "description": "Most recent 50 notifications for the token owner.",
        "responses": {
          "200": {
            "description": "Notifications plus unread count"
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/notifications/read": {
      "post": {
        "summary": "Mark notifications read",
        "description": "Omit `id` to mark everything read.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Number marked"
          },
          "401": {
            "description": "Missing or invalid token"
          }
        },
        "tags": [
          "notifications"
        ]
      }
    },
    "/api/v1/feed": {
      "get": {
        "summary": "Friend-scoped feed",
        "description": "Returns check-ins from you and accepted friends only. There is no global or public feed.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "default": 20,
              "maximum": 50
            }
          },
          {
            "name": "before",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Feed"
          }
        },
        "tags": [
          "feed"
        ]
      }
    },
    "/api/v1/friends": {
      "get": {
        "summary": "Accepted friends and pending requests",
        "responses": {
          "200": {
            "description": "Friend graph"
          }
        },
        "tags": [
          "friends"
        ]
      }
    },
    "/api/v1/friends/requests": {
      "post": {
        "summary": "Request a friendship by handle",
        "description": "Always returns 202, including for unknown handles, to prevent account enumeration.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "handle"
                ],
                "properties": {
                  "handle": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request recorded"
          },
          "429": {
            "description": "Too many requests"
          }
        },
        "tags": [
          "friends"
        ]
      }
    },
    "/api/v1/friends/requests/{id}/accept": {
      "post": {
        "summary": "Accept a pending request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "403": {
            "description": "Not addressed to you"
          }
        },
        "tags": [
          "friends"
        ]
      }
    },
    "/api/v1/friends/{id}": {
      "delete": {
        "summary": "Remove a friend or pending request",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Removed"
          }
        },
        "tags": [
          "friends"
        ]
      }
    },
    "/api/v1/checkins": {
      "post": {
        "summary": "Log a check-in",
        "description": "Requires the write scope and a verified email. Ratings are quarter-stars (0.25 steps).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CheckinInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created"
          },
          "200": {
            "description": "Idempotent replay returned the original"
          },
          "400": {
            "description": "Invalid rating or body"
          },
          "403": {
            "description": "Unverified email or insufficient scope"
          }
        },
        "tags": [
          "checkins"
        ]
      }
    },
    "/api/v1/checkins/{id}": {
      "get": {
        "summary": "Read one check-in",
        "description": "Owner, accepted friends (for `friends` check-ins) or anyone (for `public` check-ins). Other users' private rows return 404.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The check-in"
          },
          "404": {
            "description": "Missing or not visible"
          }
        },
        "tags": [
          "checkins"
        ]
      },
      "delete": {
        "summary": "Soft-delete your check-in",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "403": {
            "description": "Not yours"
          }
        },
        "tags": [
          "checkins"
        ]
      }
    },
    "/api/v1/checkins/{id}/toast": {
      "post": {
        "summary": "Toast a check-in",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Toasted"
          }
        },
        "tags": [
          "checkins"
        ]
      },
      "delete": {
        "summary": "Remove your toast",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Untoasted"
          }
        },
        "tags": [
          "checkins"
        ]
      }
    },
    "/api/v1/checkins/{id}/comments": {
      "get": {
        "summary": "List a check-in's comments",
        "description": "Visible only when the parent check-in is visible to the viewer. An invisible parent returns 404. There is no total or pagination count.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Comments oldest-first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Comment"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "Check-in missing or not visible"
          },
          "429": {
            "$ref": "#/components/responses/TooManyRequests"
          }
        },
        "tags": [
          "checkins"
        ]
      },
      "post": {
        "summary": "Comment on a check-in",
        "description": "Requires the write scope and a verified email. The parent must be visible to the viewer (404 otherwise). Capped at 1,000 characters and 30 comments per user per hour.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comment created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Comment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "description": "Missing scope or unverified email"
          },
          "404": {
            "description": "Check-in missing or not visible"
          },
          "429": {
            "description": "Hourly comment cap reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "tags": [
          "checkins"
        ]
      }
    },
    "/api/v1/comments/{id}": {
      "delete": {
        "summary": "Delete your comment",
        "description": "Authors may delete their own comment; moderators may delete any. Everyone else receives 404 so the endpoint cannot confirm that a comment exists.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
