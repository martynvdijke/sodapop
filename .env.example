# Copy to .env and adjust. Never commit .env.
APP_NAME=Sodapop
ENV=production
PORT=8097
BASE_URL=https://soda.example.com

# Required in production. Generate with: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL=720h
BCRYPT_COST=12

DATA_DIR=/data
DATABASE_PATH=/data/sodapop.db
VERSION=0.0.0-dev
LOG_LEVEL=info

# --- Authentication -------------------------------------------------------
# Authelia / any OIDC provider. Leave OIDC_ENABLED=false for local accounts.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# OIDC_CLIENT_SECRET_FILE=/run/secrets/oidc_client_secret
OIDC_REDIRECT_URL=https://soda.example.com/auth/oidc/callback
OIDC_SCOPES=openid,email,profile,groups
# One-time first-admin setup token. Leave empty to let the server generate and
# log one on a fresh database. Ignored once an admin exists.
SETUP_TOKEN=
# Local password sign-in. Defaults to true when OIDC is disabled.
ALLOW_PASSWORD_FALLBACK=true
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# --- Email ----------------------------------------------------------------
# Leave SMTP_HOST empty in development to write .eml files to EMAIL_DEV_DIR.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_PASS_FILE=/run/secrets/smtp_password
SMTP_TLS=starttls
SMTP_FROM=Sodapop <no-reply@sodapop.local>
EMAIL_DEV_DIR=/data/outbox

# --- Product data ---------------------------------------------------------
OPENFOODFACTS_ENABLED=true
OPENFOODFACTS_URL=https://world.openfoodfacts.org
# Mandatory per Open Food Facts API terms: AppName/Version (contact email)
OPENFOODFACTS_USER_AGENT=Sodapop/0.0.0-dev (admin@example.com)

# --- Analytics ------------------------------------------------------------
UMAMI_URL=
UMAMI_WEBSITE_ID=

# --- Limits / proxy -------------------------------------------------------
API_RATE_LIMIT_PER_MIN=120
# Required behind a reverse proxy: comma-separated exact IPs or CIDRs.
# Without it, /setup sees every client as the proxy IP and they share one
# rate-limit bucket. Configure it so proxy-aware limits distinguish clients.
TRUSTED_PROXIES=

# OpenCode / OpenAI-compatible AI (optional; admin-configured endpoints take precedence)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Web Push (optional; generate with `npx web-push generate-vapid-keys`)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# Native Android push (optional; raw service-account JSON or a path to the file)
FCM_SERVICE_ACCOUNT_JSON=
FCM_PROJECT_ID=
