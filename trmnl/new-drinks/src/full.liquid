{% comment %}Sodapop · New on the Shelf — full 800x480. Fields: scope, scope_label, window_label, added_24h, pending, item_count, latest, items[]{title detail status actor_handle when}{% endcomment %}
<div class="layout layout--col layout--stretch gap--xsmall">
  {% if error != blank %}
  <div class="item">
    <div class="content text--center">
      <span class="value value--medium">{{ error }}</span>
      <span class="label">could not load the shelf</span>
    </div>
  </div>
  {% else %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--medium">New on the Shelf</span>
      <span class="label">{{ scope_label }} in {{ window_label }} · {{ item_count }} new · {{ latest }}</span>
    </div>
  </div>

  <div class="grid grid--cols-2">
    <div class="item">
      <div class="content">
        <span class="value value--large">{{ added_24h }}</span>
        <span class="label label--small">{{ scope_label }} in {{ window_label }}</span>
      </div>
    </div>
    <div class="item{% if pending > 0 %} inverse{% endif %}">
      <div class="content">
        <span class="value value--large">{{ pending }}</span>
        <span class="label label--small">Pending drinks</span>
      </div>
    </div>
  </div>

  <div class="hr"></div>

  {% if items.size > 0 %}
  {% for it in items limit: 5 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">{{ it.title }}</span>
      <span class="label">{{ it.status }}</span>
    </div>
    <div class="flex flex--row flex--between w--full">
      <span class="label">{{ it.detail }}</span>
      <span class="label">{% if it.actor_handle != blank %}@{{ it.actor_handle }} · {% endif %}{{ it.when }}</span>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="item">
    <div class="content text--center">
      <span class="value value--medium">Nothing new</span>
      <span class="label">the shelf is settled — check back later</span>
    </div>
  </div>
  {% endif %}
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Shelf</span>
  </div>
</div>
