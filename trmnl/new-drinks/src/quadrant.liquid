{% comment %}Sodapop · New on the Shelf — quadrant 400x240. One number and the latest arrival.{% endcomment %}
<div class="layout layout--col layout--stretch gap">
  {% if error != blank %}
  <div class="item">
    <span class="value value--small">{{ error }}</span>
  </div>
  {% else %}
  <div class="item">
    <div class="content">
      <span class="value value--large">{{ added_24h }}</span>
      <span class="label label--small">{{ scope_label | default: "New" }} in {{ window_label }}</span>
    </div>
  </div>

  {% if pending > 0 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="label">Pending drinks</span>
      <span class="value value--small">{{ pending }}</span>
    </div>
  </div>
  {% endif %}

  {% if items.size > 0 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">{{ items[0].title }}</span>
      <span class="label">{{ items[0].status }} · {{ items[0].when }}</span>
    </div>
  </div>
  {% else %}
  <div class="item">
    <span class="value value--small">Nothing new</span>
    <span class="label">nothing added yet</span>
  </div>
  {% endif %}
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Shelf</span>
  </div>
</div>
