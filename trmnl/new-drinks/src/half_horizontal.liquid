{% comment %}Sodapop · New on the Shelf — half_horizontal 800x240. Two numbers left, two rows right.{% endcomment %}
<div class="layout layout--col layout--stretch gap--small">
  {% if error != blank %}
  <div class="item">
    <span class="value value--small">{{ error }}</span>
  </div>
  {% else %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">New on the Shelf</span>
      <span class="label">{{ scope_label }} in {{ window_label }} · {{ item_count }} new · {{ latest }}</span>
    </div>
  </div>

  <div class="columns">
    <div class="column" style="width: 280px">
      <div class="flex flex--row flex--between w--full">
        <div class="flex flex--col">
          <span class="value value--large">{{ added_24h }}</span>
          <span class="label label--small">{{ scope_label }} in {{ window_label }}</span>
        </div>
        <div class="flex flex--col">
          <span class="value value--large">{{ pending }}</span>
          <span class="label label--small">Pending drinks</span>
        </div>
      </div>
    </div>
    <div class="column w--full">
      {% if items.size > 0 %}
      {% for it in items limit: 2 %}
      <div class="item">
        <div class="flex flex--row flex--between w--full">
          <span class="value value--small">{{ it.title }}</span>
          <span class="label">{{ it.status }}{% if it.actor_handle != blank %} · @{{ it.actor_handle }}{% endif %} · {{ it.when }}</span>
        </div>
        {% if it.detail != blank %}
        <span class="label">{{ it.detail }}</span>
        {% endif %}
      </div>
      {% endfor %}
      {% else %}
      <div class="item">
        <span class="value value--small">Nothing new</span>
        <span class="label">nothing added yet</span>
      </div>
      {% endif %}
    </div>
  </div>
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Shelf</span>
  </div>
</div>
