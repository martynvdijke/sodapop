{% comment %}Sodapop · Mod Desk — half_vertical 400x480. Actionable counts first.{% endcomment %}
<div class="layout layout--col layout--stretch gap--small">
  {% if error != blank %}
  <div class="item">
    <span class="value value--small">{{ error }}</span>
  </div>
  {% else %}
  <div class="item{% if needs_attention %} inverse{% endif %}">
    <span class="value value--small">{{ banner | default: "All clear" }}</span>
    <span class="label">{{ counts.users_7d }} new users this week</span>
  </div>

  <div class="grid grid--cols-2">
    <div class="item{% if counts.open_reports > 0 %} inverse{% endif %}">
      <div class="content">
        <span class="value value--large">{{ counts.open_reports }}</span>
        <span class="label label--small">Open reports</span>
      </div>
    </div>
    <div class="item{% if counts.pending_drinks > 0 %} inverse{% endif %}">
      <div class="content">
        <span class="value value--large">{{ counts.pending_drinks }}</span>
        <span class="label label--small">Pending drinks</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--large">{{ counts.checkins_24h }}</span>
        <span class="label label--small">Check-ins</span>
      </div>
    </div>
    <div class="item">
      <div class="content">
        <span class="value value--large">{{ counts.drinks_24h }}</span>
        <span class="label label--small">Drinks</span>
      </div>
    </div>
  </div>

  <div class="hr"></div>

  <div class="item">
    <span class="label label--small">Needs attention{% if report_count > 0 %} · {{ report_count }}{% endif %}</span>
  </div>
  {% if reports.size > 0 %}
  {% for r in reports limit: 3 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">{{ r.title }}</span>
      <span class="label">{{ r.status }} · {{ r.when }}</span>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="item">
    <span class="value value--small">Nothing pending</span>
    <span class="label">no reports waiting</span>
  </div>
  {% endif %}
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Mod Desk</span>
  </div>
</div>
