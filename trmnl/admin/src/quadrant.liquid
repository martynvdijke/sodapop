{% comment %}Sodapop · Mod Desk — quadrant 400x240. Banner as the hero, then the two actionable counts.{% endcomment %}
<div class="layout layout--col layout--stretch gap">
  {% if error != blank %}
  <div class="item">
    <span class="value value--small">{{ error }}</span>
  </div>
  {% else %}
  <div class="item{% if needs_attention %} inverse{% endif %}">
    <span class="value value--small">{{ banner | default: "All clear" }}</span>
    <span class="label label--small">Mod Desk</span>
  </div>

  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <div class="flex flex--col">
        <span class="value value--medium">{{ counts.open_reports }}</span>
        <span class="label label--small">Open reports</span>
      </div>
      <div class="flex flex--col">
        <span class="value value--medium">{{ counts.pending_drinks }}</span>
        <span class="label label--small">Pending drinks</span>
      </div>
    </div>
  </div>

  {% if reports.size > 0 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">{{ reports[0].title }}</span>
      <span class="label">{{ reports[0].status }} · {{ reports[0].when }}</span>
    </div>
  </div>
  {% else %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">Nothing pending</span>
      <span class="label">{{ counts.checkins_24h }} check-ins</span>
    </div>
  </div>
  {% endif %}
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Mod Desk</span>
  </div>
</div>
