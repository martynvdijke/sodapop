{% comment %}Sodapop · Mod Desk — half_horizontal 800x240. Banner, five counts inline, three reports.{% endcomment %}
<div class="layout layout--col layout--stretch gap--small">
  {% if error != blank %}
  <div class="item">
    <span class="value value--small">{{ error }}</span>
  </div>
  {% else %}
  <div class="item{% if needs_attention %} inverse{% endif %}">
    <div class="flex flex--row flex--between w--full">
      <span class="label label--small">Mod Desk</span>
      <span class="value value--small">{{ banner | default: "All clear" }}</span>
    </div>
  </div>

  <div class="item">
    <div class="columns">
      <div class="column">
        <span class="value value--small">{{ counts.checkins_24h }}</span>
        <span class="label label--small">Check-ins</span>
      </div>
      <div class="column">
        <span class="value value--small">{{ counts.drinks_24h }}</span>
        <span class="label label--small">Drinks</span>
      </div>
      <div class="column">
        <span class="value value--small">{{ counts.users_7d }}</span>
        <span class="label label--small">New users</span>
      </div>
      <div class="column">
        <span class="value value--small">{{ counts.open_reports }}</span>
        <span class="label label--small">Reports</span>
      </div>
      <div class="column">
        <span class="value value--small">{{ counts.pending_drinks }}</span>
        <span class="label label--small">Pending</span>
      </div>
    </div>
  </div>

  {% if reports.size > 0 %}
  {% for r in reports limit: 3 %}
  <div class="item">
    <div class="flex flex--row flex--between w--full">
      <span class="value value--small">{{ r.title }}</span>
      <span class="label">{{ r.status }} · {{ r.when }}</span>
    </div>
  </div>
  {% endfor %}
  {% else %}
  <div class="item">
    <span class="value value--small">Nothing pending</span>
    <span class="label">no reports waiting</span>
  </div>
  {% endif %}
  {% endif %}
  <div class="title_bar">
    <img width="40" src="{{ trmnl.plugin_settings.custom_fields_values.url | default: 'https://sodapop.vandijke.xyz' }}/static/icon-192.png">
    <span class="title">Sodapop · Mod Desk</span>
  </div>
</div>
