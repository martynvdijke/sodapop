<?xml version="1.0" encoding="utf-8"?>
<!--
    The app keeps a bearer token and a queue of unsent check-ins on disk. Neither
    belongs in a cloud backup or on whatever device the user migrates to, so
    every domain is excluded. android:allowBackup="false" already opts out of
    backup on this platform; these rules make the intent explicit and keep the
    exclusion if that attribute is ever changed.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
